# Copy this file to .env for local Docker Compose use.
# Never commit the resulting .env file.
POSTGRES_USER=teaql_registry
POSTGRES_PASSWORD=
POSTGRES_DB=teaql_registry_db

S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=teaql-registry
S3_SECRET_KEY=
S3_BUCKET=teaql-blobs
S3_REGION=us-east-1

PORT=8081
RUST_LOG=info

# Package downloads require authentication unless this is explicitly enabled.
ALLOW_ANONYMOUS_READ=false

# Optional. When omitted, the service creates a random initial password and
# writes it to the persistent credentials volume.
# ADMIN_PASSWORD=change-this-admin-password

# Explicit recovery/reset inputs for the three example tenants. Existing
# accounts are never silently rotated when retained credential files are lost.
# TEAQL_REGISTRY_DEVELOPMENT_ADMIN_PASSWORD=change-this-password
# TEAQL_REGISTRY_DEVELOPMENT_DEVELOPER_PASSWORD=change-this-password
# TEAQL_REGISTRY_TEST_ADMIN_PASSWORD=change-this-password
# TEAQL_REGISTRY_TEST_DEVELOPER_PASSWORD=change-this-password
# TEAQL_REGISTRY_UAT_ADMIN_PASSWORD=change-this-password
# TEAQL_REGISTRY_UAT_DEVELOPER_PASSWORD=change-this-password
